generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Users {
  id         String   @id @default(uuid())

  username   String   @unique
  email      String   @unique
  password   String

  firstName  String?
  lastName   String?

  bio        String?
  avatarUrl  String?

  posts      Posts[]
  comments Comments[]

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("users")
}

model Posts {
  id    String    @id @default(uuid())

  imageUrl    String
  description   String?

  authorId String
  author Users @relation(fields: [authorId], references: [id])

  comments    Comments[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("posts")
}